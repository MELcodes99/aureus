# mock = fully offline simulation (no keys, no funds). live = NEAR mainnet + NEAR AI Cloud + 1Click.
AUREUS_MODE=live
# Live mode only moves funds when this is true. Otherwise every quote is dry.
AUREUS_EXECUTE=false

# Your trading wallet (the account you funded for the agent), e.g. b241ebf3...eb6 or trading.yourname.near
AUREUS_WALLET_ID=
# The agent's own key on that wallet. Generate with: npx tsx src/cli.ts agent-key
AUREUS_AGENT_KEY=

# NEAR AI Cloud (private inference in TEEs). Key + credits: https://cloud.near.ai
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
# Refuse to act if the enclave signature does not verify (recommended)
NEAR_AI_REQUIRE_ATTESTATION=true

NEAR_RPC=https://rpc.mainnet.near.org

# NEAR Intents 1Click. Optional key removes the 0.2% fee: https://partners.near-intents.org
ONECLICK_API_KEY=

# AES-256 key for the private decision journal: openssl rand -hex 32
AUREUS_JOURNAL_KEY=
